# Připojení k Postgres (Railway ho doplní sám jako DATABASE_URL)
DATABASE_URL=postgres://user:password@localhost:5432/trenink
# Heslo pro přihlášení do deníku – jediný uživatel
APP_PASSWORD=zmen-me
# Tajný klíč pro podpis přihlašovací cookie (libovolný dlouhý náhodný řetězec)
SESSION_SECRET=zmen-me-na-neco-dlouheho-a-nahodneho
# Port (Railway doplní sám)
PORT=3000
